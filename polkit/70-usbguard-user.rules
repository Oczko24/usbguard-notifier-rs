// /etc/polkit-1/rules.d/70-usbguard-user.rules
//
// Polkit authorization rule for usbguard-notifier-rs.
//
// Grants local, active, graphical-session users in the 'wheel' group
// permission to authorize or reject USB devices via the USBGuard D-Bus API
// without requiring interactive root authentication on each action.
//
// SECURITY CONSTRAINTS:
//   - subject.active:  Only foreground VT/seat sessions (prevents background process abuse).
//   - subject.local:   Only physically local sessions (prevents remote SSH session hijacking).
//   - subject.isInGroup("wheel"): Only administrative users.
//   - Action IDs are scoped to the minimum required set:
//       * applyDevicePolicy: change device target (allow/block/reject)
//       * appendRule: persist permanent allow rules
//       * removeRule: revoke previously saved rules
//       * listDevices: enumerate connected USB devices
//
// This rule explicitly does NOT grant blanket org.usbguard.* permissions.
// Capabilities like modifying the global ImplicitPolicyTarget or IPCAccessControl
// remain restricted to root.

polkit.addRule(function(action, subject) {
    if ((action.id === "org.usbguard.Devices1.applyDevicePolicy" ||
         action.id === "org.usbguard.Devices1.listDevices" ||
         action.id === "org.usbguard.Policy1.appendRule" ||
         action.id === "org.usbguard.Policy1.removeRule") &&
        subject.isInGroup("wheel") &&
        subject.active &&
        subject.local) {
        return polkit.Result.YES;
    }
});
